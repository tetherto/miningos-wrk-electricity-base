{
  "name": "@tetherto/miningos-wrk-electricity-base",
  "version": "1.1.0",
  "description": "Base electricity worker",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/miningos-wrk-electricity-base.git"
  },
  "homepage": "https://github.com/tetherto/miningos-wrk-electricity-base#readme",
  "bugs": {
    "url": "https://github.com/tetherto/miningos-wrk-electricity-base/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "worker.js",
    "workers/",
    "mock/"
  ],  
  "type": "commonjs",
  "bin": {
    "miningos-wrk-electricity-base": "worker.js"
  },  
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "brittle tests/unit/*.js",
    "test:integration": "NODE_ENV=test brittle tests/integration/*.js",
    "test:coverage": "brittle --coverage tests/unit/*.js",
    "dev": "node worker.js --wtype wrk-electricity-base --env development --rack rack-1",
    "mock": "node mock/server.js"
  },
  "dependencies": {
    "@bitfinex/bfx-svc-boot-js": "1.3.1",
    "@bitfinex/lib-js-util-base": "^2.1.0",
    "@bitfinex/bfx-facs-http": "^1.1.3",
    "@tetherto/hp-svc-facs-store": "^1.0.1",
    "@tetherto/miningos-tpl-wrk-electricity": "git+https://github.com/tetherto/miningos-tpl-wrk-electricity.git"
  },
  "devDependencies": {
    "brittle": "3.16.3",
    "fastify": "5.12.1",
    "@tetherto/miningos-mock-control-service": "git+https://github.com/tetherto/miningos-mock-control-service.git",
    "standard": "17.1.2"
  }
}
